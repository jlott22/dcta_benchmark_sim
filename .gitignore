# Python bytecode and interpreter caches
__pycache__/
*.py[cod]
*$py.class

# Test, type-checker, and coverage caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Local virtual environments
.venv/
venv/
env/

# Editor and operating-system metadata
.idea/
.vscode/
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
*.log
*~
*.asv

# Private pre-release archive. Keep its README so collaborators understand
# where local historical material belongs, but never publish its contents.
/archive_private/*
!/archive_private/README.md

# Generated figures and image artifacts
*.fig
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.tif
*.tiff
*.webp
*.svg
*.eps

# Final paper figures and their editable MATLAB copies are release artifacts.
!/results/analysis/figures/*.png
!/results/analysis/figures/inspection/
!/results/analysis/figures/inspection/*.png
!/results/analysis/figures/inspection/*.fig

# Transient study execution state (preserve combined CSV/JSON and manifests)
/results/**/logs/
/results/**/parts/
/results/**/launcher.pid
/results/**/monitor_progress.py
/results/**/start_all_*.sh
/results/**/_trial_journal.jsonl
/results/**/_FAILED.txt
/results/**/_COMPLETE.txt
